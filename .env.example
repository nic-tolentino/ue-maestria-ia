# Phone Notifications (optional — pick whichever you prefer!)
# 1) ntfy.sh (easiest: install ntfy app on iOS/Android & subscribe to a private topic)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# 2) Telegram Bot (optional alternative)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3) Generic Webhook (optional — Discord, Slack, Pushover relay, etc.)
NOTIFY_WEBHOOK_URL=

# Optional public URL used in phone notification deep links (e.g. https://ue-ai.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Optional admin key for deleting/pinning comments (Phase 2 / production)
ADMIN_SECRET=
