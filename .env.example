# =============================================================================
# 1) Database — Neon Postgres (leave blank in local dev to use mock data!)
# =============================================================================
# Automatically injected by Vercel if you add Neon via Vercel Storage.
# When unset (or when USE_MOCK_STORE=true), the app runs against the local
# file store in `.data/comments.json` with dev mock comments pre-seeded.
DATABASE_URL=

# Optional dev toggles:
# Set USE_MOCK_STORE=true to force local mock data even if DATABASE_URL is set.
# USE_MOCK_STORE=true
# Set SEED_MOCK_COMMENTS=false if you want mock mode to start with 0 comments.
# SEED_MOCK_COMMENTS=false

# =============================================================================
# 2) Phone Notifications — ntfy.sh (Recommended)
# =============================================================================
# Install the free "ntfy" app on iOS/Android, subscribe to a private topic name
# (e.g. ue-ai-master-alerts-9f3k2a), and paste that same topic name below.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Optional alternatives (leave blank if using ntfy.sh):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=

# =============================================================================
# 3) Organizer Admin Moderation
# =============================================================================
# Secret passphrase used in the footer "Admin" lock button to pin, restore,
# or delete comments directly from your phone or browser.
# (In local `npm run dev`, if left blank, the fallback key is "dev".)
ADMIN_SECRET=

# =============================================================================
# 4) Public Site URL (optional — auto-detected on Vercel)
# =============================================================================
# Used for tap-to-open deep links inside ntfy.sh phone notifications.
# Example: https://ue-maestria-ia.vercel.app
NEXT_PUBLIC_SITE_URL=
